# Nubra Community Manager — .env template (copy values into the repo-root .env)
# Secrets NEVER go in git; .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...
TWITTERAPI_IO_KEY=...

DB_URL=postgresql://community:community@localhost:5544/nubra_community
OUT_DIR=out/messages

# ── optional add-on collectors ───────────────────────────────────────────────
# YouTube Data API v3 key. Required only when sources.youtube.enabled=true.
YOUTUBE_API_KEY=

# Optional GitHub token. Public GitHub search works without this, but a token
# gives better rate limits and reliability when sources.github.enabled=true.
GITHUB_TOKEN=

# ── Instagram (Apify route; unset APIFY_TOKEN = collector off) ──
# Local/dev: free-account token. Prod: paid Starter token (user swaps at release).
APIFY_TOKEN=
# S3 bucket for reel/carousel media (same reports bucket as
# nubra-ai-personalization; unset = media persistence off, captions still flow).
# AWS creds come from the standard AWS_* env/instance role.
S3_BUCKET=
AWS_DEFAULT_REGION=ap-south-1

# Reddit egress proxy (unset = direct). Prod VM's IP is served the new-site
# shell by Reddit (2026-08-10 incident) — residential proxy restores old.reddit.
# Format: http://<user>:<pass>@host:port — e.g. Apify residential:
# REDDIT_PROXY_URL=http://groups-RESIDENTIAL,country-IN:<apify-proxy-password>@proxy.apify.com:8000

# ── Dashboard SSO (oauth2-proxy; unset = the service refuses to start) ──
# Google OAuth client: console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID (Web application) → authorized redirect URI:
#   https://nubra-beacon.zanskar.xyz/oauth2/callback
# OAUTH2_PROXY_CLIENT_ID=xxxx.apps.googleusercontent.com
# OAUTH2_PROXY_CLIENT_SECRET=GOCSPX-...
# Cookie secret (generate once): python3 -c 'import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# OAUTH2_PROXY_COOKIE_SECRET=
# BEACON_SSO_REDIRECT_URL=https://nubra-beacon.zanskar.xyz/oauth2/callback

# Slack app signing secret — verifies Approve/Reject button callbacks on
# /api/v1/slack/interactions (api.slack.com/apps -> app -> Basic Information).
# SLACK_SIGNING_SECRET=

# ── LLM tracing (unset = Langfuse disabled; llm_usage table always written) ──
# Keys from a NEW Langfuse project named "nubra-beacon" (cloud.langfuse.com →
# New project). Deliberately a SEPARATE stream from nubra-ai-personalization.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── dispatch channels (unset = channel skipped; archive always written) ──
# Slack incoming webhook for the heads-up/roundup channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# Gmail sender + app password (myaccount.google.com → Security → App passwords)
# GMAIL_SENDER=team@nubra.in
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# recipients list lives in community/config/registry.yaml → delivery.email_recipients

# ── prod release (compose image tag; mirrors nubra-ai-personalization) ──
# Dev Mac: RELEASE_TAG=2026-07-09-Jatin make push-prod
# Prod:    set the same tag here, then: make pull-prod
# RELEASE_TAG=latest
